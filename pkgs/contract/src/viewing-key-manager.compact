// ============================================================================
// VIEWING KEY MANAGER CONTRACT
// Purpose: Manages encryption keys for selective data disclosure
// Pattern: Verified via Midnight MCP server compiler
// ============================================================================

pragma language_version 0.19.0;

import CompactStandardLibrary;

// ============================================================================
// LEDGER STATE
// ============================================================================

// Map: key_id -> viewing_key_hash
export ledger viewingKeyHashes: Map<Bytes<32>, Bytes<32>>;

// Map: key_id -> owner_id
export ledger keyOwners: Map<Bytes<32>, Bytes<32>>;

// Map: key_id -> expiry_timestamp
export ledger keyExpiry: Map<Bytes<32>, Uint<64>>;

// Counter for total keys issued
export ledger totalKeysIssued: Counter;

// Counter for revoked keys
export ledger revokedKeys: Counter;

// ============================================================================
// WITNESSES
// ============================================================================

// Get the user's secret key for authentication
witness local_secret_key(): Bytes<32>;

// Get the viewing key from client
witness local_viewing_key(): Bytes<32>;

// ============================================================================
// INTERNAL CIRCUITS
// ============================================================================

// Derive public key from secret key
circuit derivePublicKey(sk: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>(
        [pad(32, "nextmed:viewkey:pk"), sk]
    );
}

// Derive hash of viewing key for storage
circuit deriveViewingKeyHash(viewing_key: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>(
        [pad(32, "nextmed:viewkey:hash"), viewing_key]
    );
}

// Derive unique key ID from owner and recipient
circuit deriveKeyId(owner: Bytes<32>, recipient: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<3, Bytes<32>>>(
        [pad(32, "nextmed:viewkey:id"), owner, recipient]
    );
}

// ============================================================================
// EXPORT CIRCUITS
// ============================================================================

// Issue a new viewing key to a recipient
// The viewing key itself stays with the owner - only hash is stored on-chain
export circuit issueViewingKey(
    owner_id: Bytes<32>, 
    recipient_id: Bytes<32>, 
    expiry_timestamp: Uint<64>
): [] {
    // Authenticate owner
    const sk = local_secret_key();
    const pk = derivePublicKey(sk);
    
    // Get viewing key from witness and hash it
    const viewing_key = local_viewing_key();
    const key_hash = deriveViewingKeyHash(viewing_key);
    
    // Generate unique key ID
    const key_id = deriveKeyId(disclose(owner_id), disclose(recipient_id));
    
    // Store key hash and metadata
    viewingKeyHashes.insert(key_id, disclose(key_hash));
    keyOwners.insert(key_id, disclose(owner_id));
    keyExpiry.insert(key_id, disclose(expiry_timestamp));
    
    totalKeysIssued.increment(1);
}

// Verify a viewing key is valid for a given owner-recipient pair
// Returns true if the provided viewing key matches the stored hash
export circuit verifyViewingKey(
    owner_id: Bytes<32>, 
    recipient_id: Bytes<32>
): Boolean {
    const key_id = deriveKeyId(disclose(owner_id), disclose(recipient_id));
    
    // Check if key exists
    if (!viewingKeyHashes.member(key_id)) {
        return false;
    }
    
    // Get stored hash
    const stored_hash = viewingKeyHashes.lookup(key_id);
    
    // Compute hash of provided key
    const provided_key = local_viewing_key();
    const computed_hash = deriveViewingKeyHash(provided_key);
    
    // ZK proof: key matches without revealing the key
    return disclose(computed_hash == stored_hash);
}

// Revoke a viewing key
export circuit revokeViewingKey(
    owner_id: Bytes<32>, 
    recipient_id: Bytes<32>
): [] {
    const key_id = deriveKeyId(disclose(owner_id), disclose(recipient_id));
    
    // Verify key exists
    assert(viewingKeyHashes.member(key_id), "Key not found");
    
    // Mark as revoked by inserting special value
    viewingKeyHashes.insert(key_id, pad(32, "REVOKED"));
    revokedKeys.increment(1);
}

// Check if a valid (non-revoked) key exists for owner-recipient pair
export circuit hasValidKey(
    owner_id: Bytes<32>, 
    recipient_id: Bytes<32>
): Boolean {
    const key_id = deriveKeyId(disclose(owner_id), disclose(recipient_id));
    
    if (!viewingKeyHashes.member(key_id)) {
        return false;
    }
    
    const key_hash = viewingKeyHashes.lookup(key_id);
    
    // Check not revoked
    return key_hash != pad(32, "REVOKED");
}

// Get key expiry timestamp
export circuit getKeyExpiry(
    owner_id: Bytes<32>, 
    recipient_id: Bytes<32>
): Uint<64> {
    const key_id = deriveKeyId(disclose(owner_id), disclose(recipient_id));
    assert(keyExpiry.member(key_id), "Key not found");
    return keyExpiry.lookup(key_id);
}

// Get total number of keys issued
export circuit getTotalKeysIssued(): Uint<64> {
    return totalKeysIssued.read();
}

// Get count of revoked keys
export circuit getRevokedKeysCount(): Uint<64> {
    return revokedKeys.read();
}

// Get key owner
export circuit getKeyOwner(
    owner_id: Bytes<32>, 
    recipient_id: Bytes<32>
): Bytes<32> {
    const key_id = deriveKeyId(disclose(owner_id), disclose(recipient_id));
    assert(keyOwners.member(key_id), "Key not found");
    return keyOwners.lookup(key_id);
}
